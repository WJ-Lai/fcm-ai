# FCM Agent API credentials.
# Copy to .env and fill in. NEVER commit the real file.
#
# The wiki (scripts/ask.py) needs no credentials at all — only the game client does.

# Personal agent token, issued by the OBG server. Format: obg_pat_<id>_<secret>
# Get one from the host's Agent identities page, or via
#   POST /FCM/agent/v1/identities/<id>/tokens/
FCM_AGENT_TOKEN=

# Base URL of the game server. Default is a local OBG instance.
FCM_BASE_URL=http://127.0.0.1:8000
